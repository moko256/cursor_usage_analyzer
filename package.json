{
	"name": "cursor-usage-analyzer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"test:e2e": "node ./scripts/e2e-dev-server.mjs --stop && playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-m-function-matcher": "2.4.3",
		"@inlang/plugin-message-format": "4.6.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-time": "^3.0.4",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"lightningcss": "^1.33.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.0",
		"sass-embedded": "^1.108.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"terser": "^5.51.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@picocss/pico": "^2.1.1",
		"d3-interpolate": "^3.0.2",
		"d3-scale": "^4.0.3",
		"d3-scale-chromatic": "^3.1.1",
		"d3-time": "^3.1.1",
		"kiso.css": "^1.2.4",
		"layerchart": "^2.10.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
