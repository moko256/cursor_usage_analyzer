{
	"name": "cursor-usage-analyzer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"test:e2e": "node ./scripts/e2e-dev-server.mjs --stop && playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/node": "^26.4.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lightningcss": "^1.33.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass-embedded": "^1.103.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.7.6",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@picocss/pico": "^2.1.1",
		"d3-interpolate": "^3.0.1",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"kiso.css": "^1.2.4",
		"layerchart": "^2.3.1"
	}
}
